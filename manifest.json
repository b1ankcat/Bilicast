{
  "manifest_version": 3,
  "name": "Bilicast Playlist",
  "description": "在 B 站视频页快速收集并后台播放自定义播放列表。",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "offscreen",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Bilicast 播放列表"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*"
      ],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/shared/messages.js",
        "src/shared/playlist.js",
        "src/shared/video.js",
        "src/content/content-shell.js",
        "src/content/page-anchor.js",
        "src/content/playlist-popover.js",
        "src/content/runtime.js",
        "src/content/ui.js",
        "src/content/video-info.js"
      ],
      "matches": ["https://www.bilibili.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
